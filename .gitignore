# 1. 编译生成的文件 (Maven/Gradle)
target/
build/
out/
!.mvn/wrapper/maven-wrapper.jar

# 2. IntelliJ IDEA 配置文件
# 忽略大部分 IDEA 配置
.idea/
*.iws
*.iml
*.ipr
# 但保留代码风格配置（可选，建议团队统一风格时保留）
# !.idea/codeStyles/

# 3. Eclipse 配置文件 (如果不用 Eclipse 可以忽略)
.classpath
.project
.settings/
bin/

# 4. 日志和临时文件
*.log
logs/
*.tmp
*.swp

# 5. 操作系统生成的文件
.DS_Store
Thumbs.db

# 6. 敏感配置文件 (非常重要)
# 如果你把数据库密码等写在配置文件里，建议忽略具体的配置文件
# 或者使用 application-local.yml 这种格式，只上传 application.yml 模板
application-*.yml
!application.yml

# 7. Spring Boot DevTools
.spring-boot-devtools

# 8. Java 编译类文件
*.class
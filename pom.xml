<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!--  xmlns命名空间声明所有标签属于Maven 4.0.0 家族-->
    <!--  xsi提供校验单规定文件格式书写-->


    <!--  指定当前pom模型的版本-->
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github</groupId>
    <!--  Maven坐标，唯一-->
    <artifactId>singlestructure-template</artifactId>
    <version>1.0-SNAPSHOT</version>
    <!--  打包方式 -->
    <packaging>jar</packaging>
    <!--  名称，会显示在Maven管理仓库中，要唯一-->
    <name>singlestructure-template</name>
    <!--    项目地址-->
    <url>http://maven.apache.org</url>

    <!--  全局配置-->
    <properties>
        <!--    统一编码格式-->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 强制锁定编译版本为 Java 17 (SpringBoot 3 的底线) -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!--    以下通用管理中间件版本型号-->
        <spring-boot.version>3.2.5</spring-boot.version><!--依赖传递，spring-cloud依赖spring-boot，不用再指定spring-boot版本，指定的话要求兼容版本-->
        <mybatis-plus-boot-starter.version>3.4.1</mybatis-plus-boot-starter.version> <!--mybatis-plus依赖-->
    </properties>

    <!--  只统一锁定版本，不强制引入-->
    <dependencyManagement>
        <dependencies>
            <!-- SpringBoot 依赖菜单 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version> <!--只需占位，在properties里面声明具体版本-->
                <type>pom</type> <!--声明依赖类型-->
                <scope>import</scope> <!--意为引入，从官方spring-boot-dependencies这个pom文件引入所有配置（如 Spring Framework, Jackson, Tomcat 等）-->
            </dependency>
            <!-- 注册 MyBatisPlus Starter -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-boot-starter</artifactId>
                <version>${mybatis-plus-boot-starter.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--  导入全局依赖，只放所有板块都会用到的依赖-->
    <dependencies>
        <!--    Lombok依赖
            @Data快速生成实体类方法
            @Builder链式调用
            @Slf4j日志注入
            @NoArgsConstructor / @AllArgsConstructor一键生成无参构造函数或全参构造函数-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <!-- 引入 MyBatisPlus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>
        <!-- 引入 MySQL 驱动，连数据库（版本同样可以在父工程管，或者直接靠 SpringBoot 的默认版本） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId> <!--版本控制已由SpringBoot接管-->
        </dependency>
        <!-- SpringBoot Web 核心依赖 (包含了 Spring MVC 框架和内置的 Tomcat 服务器) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- SpringBoot 参数校验模块 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--    redis数据库驱动-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- JWT 依赖 (Spring Boot 未接管版本，需手动指定) -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>4.4.0</version>
        </dependency>
        <!-- Spring Boot AOP 切面编程依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>

    <!-- 构建配置 -->
    <build>
        <plugins>
            <!-- SpringBoot 打包插件，必须有它才能打出可运行的 Fat Jar (包含 Tomcat 的独立运行包) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>


</project>
